# Omnigent UBI images: server (default target) + host (`--target host`)
# + OpenShell sandbox host (`--target host-openshell`).
#
# Red Hat Universal Base Image (UBI 9) variant of the standard Dockerfile,
# for RHEL/OpenShift environments that require UBI-compliant containers.
# Same structure as the standard Dockerfile plus an OpenShell-specific
# host variant: `runtime` (server), `host` (sandbox), `host-openshell`.
#
# Build (from repo root):
#
#   docker build -t omnigent-server:ubi \
#                -f deploy/docker/Dockerfile.ubi .
#
#   docker build -t omnigent-host:ubi --target host \
#                -f deploy/docker/Dockerfile.ubi .
#
#   docker build -t omnigent-host-openshell:ubi --target host-openshell \
#                -f deploy/docker/Dockerfile.ubi .

ARG PYTHON_VERSION=3.12
ARG NODE_VERSION=22

# ── Web UI builder ──────────────────────────────────────
# Build-platform pinned like the standard Dockerfile's web-builder: the
# bundle is arch-independent and the emulated arm64 web build has stalled.
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/nodejs-${NODE_VERSION} AS web-builder
ARG NPM_CONFIG_REGISTRY=
ENV NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY}

USER 0
WORKDIR /web

# Workspace manifests + lockfile first so the install layer caches across pure
# source edits. The electron package JSON is included so the root workspace is
# structurally complete, but we --filter web to avoid downloading Electron.
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
COPY patches/ ./patches/
COPY web/package.json ./web/
COPY web/electron/package.json ./web/electron/

RUN npm install -g pnpm@11.15.1
RUN pnpm install --frozen-lockfile --filter web

COPY web/ ./web/
RUN pnpm --filter web run build

# ── Python builder (shared: server + host) ──────────────
FROM registry.access.redhat.com/ubi9/python-312 AS builder

ARG PYPI_INDEX_URL=https://pypi.org/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

USER 0

RUN dnf install -y --nodocs gcc gcc-c++ make python3-devel \
 && dnf clean all

RUN pip install --index-url ${PYPI_INDEX_URL} --no-cache-dir uv

WORKDIR /build

COPY pyproject.toml setup.py ./
COPY LICENSE NOTICE ./
COPY sdks/ ./sdks/
COPY omnigent/ ./omnigent/
COPY examples/ ./examples/

RUN python -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

RUN uv pip install --no-cache-dir --index-url ${PYPI_INDEX_URL} -e .

# ── Server builder ──────────────────────────────────────
FROM builder AS server-builder

ARG PYPI_INDEX_URL=https://pypi.org/simple

COPY --from=web-builder /web/omnigent/server/static/web-ui ./omnigent/server/static/web-ui
RUN test -f ./omnigent/server/static/web-ui/index.html \
    || (echo "ERROR: SPA bundle missing after web-builder stage — check the web build." && exit 1)

RUN uv pip install --no-cache-dir --index-url ${PYPI_INDEX_URL} 'psycopg[binary]>=3.1,<4'

# ── Node alias stage ─────────────────────────────────────
FROM registry.access.redhat.com/ubi9/nodejs-${NODE_VERSION} AS node-runtime

# ── Native tools builder ─────────────────────────────────
# tmux and bubblewrap are not in the UBI 9 repos: the unentitled UBI
# AppStream subset omits them, full RHEL needs a subscription, and EPEL
# cannot duplicate RHEL packages. Build them from source and COPY just
# the binaries into the host stages. Pinned + sha256-verified like the
# other non-dnf downloads (kiro, agy, gh). The builder is CentOS Stream
# 9, not a newer Fedora: it shares UBI 9's glibc (2.34), whereas a
# Fedora-built binary needs GLIBC_2.38+ and fails to load on UBI 9.
FROM quay.io/centos/centos:stream9 AS native-builder

ARG TMUX_VERSION=3.5a
ARG TMUX_SHA256=16216bd0877170dfcc64157085ba9013610b12b082548c7c9542cc0103198951
ARG BWRAP_VERSION=0.11.0
ARG BWRAP_SHA256=988fd6b232dafa04b8b8198723efeaccdb3c6aa9c1c7936219d5791a8b7a8646

# meson is in CS9's CodeReady Builder repo (disabled by default); the
# curl command comes from the preinstalled curl-minimal.
RUN dnf --enablerepo=crb install -y --nodocs \
        gcc make bison libevent-devel ncurses-devel \
        meson libcap-devel xz \
 && dnf clean all

RUN set -eu; \
    curl -fsSL "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" -o /tmp/tmux.tar.gz; \
    echo "${TMUX_SHA256}  /tmp/tmux.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/tmux.tar.gz -C /tmp; \
    cd /tmp/tmux-${TMUX_VERSION}; \
    ./configure --prefix=/usr/local; \
    make -j"$(nproc)"; \
    make install

RUN set -eu; \
    curl -fsSL "https://github.com/containers/bubblewrap/releases/download/v${BWRAP_VERSION}/bubblewrap-${BWRAP_VERSION}.tar.xz" -o /tmp/bwrap.tar.xz; \
    echo "${BWRAP_SHA256}  /tmp/bwrap.tar.xz" | sha256sum -c -; \
    tar -xf /tmp/bwrap.tar.xz -C /tmp; \
    cd /tmp/bubblewrap-${BWRAP_VERSION}; \
    meson setup builddir --prefix=/usr/local; \
    meson compile -C builddir; \
    meson install -C builddir

# ── Host runtime (`--target host`) ──────────────────────
FROM registry.access.redhat.com/ubi9/python-312 AS host
ARG NPM_CONFIG_REGISTRY=
ENV NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:${PATH}" \
    IS_SANDBOX=1

USER 0

# curl-minimal and ca-certificates are preinstalled in UBI9. bzip2 ships on
# every host so the goose EXTRA_HARNESS_CLIS row works without another
# package-list edit (goose's release archive is .tar.bz2). libevent,
# ncurses-libs, and libcap are the runtime libraries for the source-built
# tmux and bubblewrap below.
RUN dnf install -y --nodocs git unzip bzip2 \
        libevent ncurses-libs libcap \
 && dnf clean all

# tmux + bubblewrap binaries from the native-builder stage (not in the
# UBI 9 repos — see that stage's header note).
COPY --from=native-builder /usr/local/bin/tmux /usr/local/bin/tmux
COPY --from=native-builder /usr/local/bin/bwrap /usr/local/bin/bwrap

RUN git config --system credential.helper \
      '!f() { [ "$1" = get ] || return 0; [ -n "$GIT_TOKEN" ] || return 0; printf "username=%s\npassword=%s\n" "${GIT_USERNAME:-x-access-token}" "$GIT_TOKEN"; }; f'

# Node runtime from the UBI Node image.
COPY --from=node-runtime /usr/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

RUN npm install -g --no-audit --no-fund \
      @anthropic-ai/claude-code \
      @openai/codex \
      @earendil-works/pi-coding-agent \
 && npm cache clean --force

# Kiro CLI is not published as an npm package and its installer has no version
# flag (always fetches `latest`). Pin it by fetching the immutable per-arch zip
# from the versioned CDN path + verifying sha256, then running the package's own
# install.sh and copying the binaries onto the global PATH. The `--version` check
# asserts the binary is the pinned version (a sanity guard atop the sha256). See
# the fuller rationale in deploy/docker/Dockerfile — keep KIRO_CLI_VERSION + both
# SHA256s in sync. HOME=/root on the install.sh line because the UBI python image
# sets HOME=/opt/app-root/src even for root, and the installer is HOME-bound.
ARG KIRO_CLI_VERSION=2.10.0
ARG KIRO_CLI_SHA256_AMD64=be9d8b6d7c44f93a83ca22466043d98ad058e6ed3c12fffd068f3fb8a60b3b70
ARG KIRO_CLI_SHA256_ARM64=0afb37399b9e2847c2f2e3f5d9052c8bc52bbf1e30401ea284a602661bce34bc
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64)  asset="kirocli-x86_64-linux.zip";  sha="$KIRO_CLI_SHA256_AMD64" ;; \
      aarch64) asset="kirocli-aarch64-linux.zip"; sha="$KIRO_CLI_SHA256_ARM64" ;; \
      *) echo "ERROR: unsupported arch '$(uname -m)' for kiro-cli" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/kiro.zip "https://prod.download.cli.kiro.dev/stable/${KIRO_CLI_VERSION}/${asset}"; \
    echo "${sha}  /tmp/kiro.zip" | sha256sum -c -; \
    unzip -q /tmp/kiro.zip -d /tmp/kiro; \
    HOME=/root KIRO_CLI_SKIP_SETUP=1 sh /tmp/kiro/kirocli/install.sh; \
    install -m 0755 /root/.local/bin/kiro-cli /usr/local/bin/kiro-cli; \
    if [ -f /root/.local/bin/kiro-cli-chat ]; then \
      install -m 0755 /root/.local/bin/kiro-cli-chat /usr/local/bin/kiro-cli-chat; \
    fi; \
    rm -rf /tmp/kiro /tmp/kiro.zip; \
    installed="$(/usr/local/bin/kiro-cli --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"; \
    [ "$installed" = "$KIRO_CLI_VERSION" ] || { \
      echo "ERROR: kiro-cli reports '${installed:-<none>}', expected '$KIRO_CLI_VERSION'." >&2; exit 1; }; \
    echo "kiro-cli ${KIRO_CLI_VERSION} pinned (sha256 verified)"

# agy is not baked into UBI by default — install it via EXTRA_HARNESS_CLIS=agy,
# which pins the same immutable per-arch release asset + sha256 as the default
# image. Keep AGY_VERSION and both SHA256s in sync with deploy/docker/Dockerfile.
ARG AGY_VERSION=1.1.16
ARG AGY_SHA256_AMD64=7742953b7835b457e9102f1357a493913657dfd147435584f609d58356ec085a
ARG AGY_SHA256_ARM64=c71599bb548cf72dfe7a8f6c411b3c7a3623cd4b0f6276bae89c69f769d6c92d
ENV AGY_VERSION=${AGY_VERSION} \
    AGY_SHA256_AMD64=${AGY_SHA256_AMD64} \
    AGY_SHA256_ARM64=${AGY_SHA256_ARM64}

# GitHub CLI (`gh`) — the read-only "GitHub" side panel shells out to it (and
# agents reach for it), authenticated per-user from the credential broker (see
# omnigent/runner/github_resource.py). Not an npm package, so fetch the immutable
# per-arch tarball from the versioned GitHub release, verify sha256, install the
# binary on the shared PATH, and assert the version. Mirrors the block in
# deploy/docker/Dockerfile — keep GH_VERSION + both SHA256s in sync with it.
ARG GH_VERSION=2.103.0
ARG GH_SHA256_AMD64=fdd768eb70f6409f80fcfa9f3a1c0adf0fc98d827ab3ce0bed2ac22762c5d786
ARG GH_SHA256_ARM64=7f322df34e624d14f5ec0c4acb121fd6dfa14392fdbbd1066aa8e0a05ac3721e
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64)  arch="amd64"; sha="$GH_SHA256_AMD64" ;; \
      aarch64) arch="arm64"; sha="$GH_SHA256_ARM64" ;; \
      *) echo "ERROR: unsupported arch '$(uname -m)' for gh" >&2; exit 1 ;; \
    esac; \
    asset="gh_${GH_VERSION}_linux_${arch}.tar.gz"; \
    curl -fsSL -o /tmp/gh.tar.gz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/${asset}"; \
    echo "${sha}  /tmp/gh.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/gh.tar.gz -C /tmp "gh_${GH_VERSION}_linux_${arch}/bin/gh"; \
    install -m 0755 "/tmp/gh_${GH_VERSION}_linux_${arch}/bin/gh" /usr/local/bin/gh; \
    rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_${arch}"; \
    installed="$(/usr/local/bin/gh --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"; \
    [ "$installed" = "$GH_VERSION" ] || { \
      echo "ERROR: gh reports '${installed:-<none>}', expected '$GH_VERSION'." >&2; exit 1; }; \
    echo "gh ${GH_VERSION} pinned (sha256 verified)"

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build /build

RUN echo 'export PATH="/opt/venv/bin:${PATH}"' > /etc/profile.d/omnigent-venv.sh

# Optional extra harness CLIs, off by default — see install-harness-cli.sh and
# deploy/docker/README.md for names, pins, and the npm: escape hatch. Kept at
# the end of the stage so script churn doesn't bust the layers above; removed
# after use.
ARG EXTRA_HARNESS_CLIS=
COPY deploy/docker/install-harness-cli.sh /tmp/install-harness-cli.sh
RUN if [ -n "${EXTRA_HARNESS_CLIS}" ]; then \
        set -f; \
        bash /tmp/install-harness-cli.sh ${EXTRA_HARNESS_CLIS}; \
    fi; \
    rm -f /tmp/install-harness-cli.sh

WORKDIR /root
CMD ["sleep", "infinity"]

# The UBI python image exports BASH_ENV/ENV/PROMPT_COMMAND pointing at
# /opt/app-root/bin/activate, which bash sources for every
# non-interactive shell — silently re-pointing VIRTUAL_ENV and PATH at
# the image's s2i venv ahead of ours (so a `bash -c` pip resolves to the
# wrong venv). Empty values disable the hooks. Declared at the end of
# the stage so the layer cache above is unaffected.
ENV BASH_ENV="" \
    ENV="" \
    PROMPT_COMMAND=""

# ── OpenShell host runtime (`--target host-openshell`) ──
# UBI 9 host for NVIDIA OpenShell sandboxes (deploy/openshell/README.md),
# extending `host` with the OpenShell sandbox contract: a non-root
# `sandbox` user, a writable venv at /sandbox/.venv (the sandbox policy
# leaves only /sandbox and /tmp writable, so the launcher's wheel overlay
# must install there), and a baked /etc/openshell/policy.yaml egress
# allow-list. OpenShell injects its own supervisor as the container
# entrypoint, so the image's ENTRYPOINT is only a fallback.
FROM host AS host-openshell

ARG PYPI_INDEX_URL=https://pypi.org/simple

# OpenShell extras the base `host` stage omits: iproute/nftables build
# the per-sandbox network namespace; procps-ng/lsof let the
# antigravity-native executor find agy's connect-RPC port (lsof has no
# fallback). tmux and bubblewrap are inherited from the base host stage.
RUN dnf install -y --nodocs \
        iproute nftables procps-ng lsof \
 && dnf clean all

# OpenShell drops privileges to a user literally named `sandbox` and
# fails closed without it. A system account with an image-local UID:
# OpenShift assigns an arbitrary UID at runtime, so the exact UID here
# doesn't matter — only the name does.
RUN groupadd -r sandbox \
 && useradd -r -g sandbox -d /sandbox -s /bin/bash sandbox

# opencode harness CLI, on top of the base host's claude/codex/pi/kiro set.
RUN npm install -g --no-audit --no-fund opencode-ai \
 && npm cache clean --force

# Replace /opt/venv with a writable venv under /sandbox: the sandbox
# policy marks everything outside /sandbox and /tmp read-only, and the
# launcher overlays wheels into the venv at provision time. Rebuilt from
# the builder's source tree rather than copying /opt/venv, whose
# editable .pth files reference /build (denied by the sandbox filesystem
# policy). python-socks + websockets carry the host's dial-back through
# the sandbox's policy proxy. python3.12 is named explicitly: this
# stage's PATH drops the image's /opt/app-root bin, and the remaining
# /usr/bin/python3 is RHEL 9's 3.9. HOME is re-pinned because the base
# image's config env pins it to /opt/app-root/src, which would shadow
# the sandbox user's home at runtime.
ENV PATH="/sandbox/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin" \
    VIRTUAL_ENV="/sandbox/.venv" \
    HOME="/sandbox"
RUN python3.12 -m venv /sandbox/.venv \
 && /sandbox/.venv/bin/pip install --no-cache-dir --index-url ${PYPI_INDEX_URL} --upgrade pip \
 && /sandbox/.venv/bin/pip install --no-cache-dir --index-url ${PYPI_INDEX_URL} \
      /build /build/sdks/python-client /build/sdks/ui \
      "python-socks[asyncio]" \
 && /sandbox/.venv/bin/pip install --no-cache-dir --no-deps "websockets>=15" \
 && rm -rf /opt/venv /build

# Login-shell PATH (overwrites the base host's /opt/venv snippet).
RUN echo 'export PATH="/sandbox/.venv/bin:${PATH}"' > /etc/profile.d/omnigent-venv.sh

# OpenShell helper: the deny-by-default egress policy.
COPY deploy/docker/openshell/policy.yaml /etc/openshell/policy.yaml

# Shell init for the sandbox user. .bash_profile (what bash login shells
# read first) sources .bashrc, which sets up the venv PATH.
RUN printf 'export PATH="/sandbox/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin"\nexport VIRTUAL_ENV="/sandbox/.venv"\nexport PS1="sandbox@\\h:\\w\\$ "\n' \
      > /sandbox/.bashrc \
 && printf '[ -f ~/.bashrc ] && . ~/.bashrc\n' > /sandbox/.bash_profile

# OpenShift runs the sandbox under an arbitrary UID with primary GID 0,
# so group-writable /sandbox (same pattern as the server stage's /data)
# keeps the launcher's wheel overlay and agent workspaces working there.
# Locally (image user = owner) the owner perms still apply.
RUN chown -R sandbox:0 /sandbox \
 && chmod -R g=u /sandbox

USER sandbox
WORKDIR /sandbox
ENTRYPOINT ["/bin/bash"]

# ── Server runtime (default target) ─────────────────────
FROM registry.access.redhat.com/ubi9/python-312 AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:${PATH}"

USER 0

# curl-minimal and ca-certificates are preinstalled in UBI9;
# installing full curl would conflict with curl-minimal.


COPY --from=server-builder /opt/venv /opt/venv
COPY --from=server-builder /build /build
COPY deploy/docker/entrypoint.py /app/entrypoint.py

WORKDIR /app

RUN mkdir -p /data/artifacts \
 && chown -R 1001:0 /data \
 && chmod -R g=u /data

ENV PORT=8000 \
    HOST=0.0.0.0 \
    ARTIFACT_DIR=/data/artifacts

EXPOSE 8000

USER 1001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1

CMD ["python", "/app/entrypoint.py"]
